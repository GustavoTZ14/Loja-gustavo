model User {
  id            String       @id(map: "user_pkey")
  name          String
  email         String
  role          String       @default("user")
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     Timestamp(3) @default(now())
  updatedAt     Timestamp(3)
  accounts      Account[]
  sessions      Session[]

  @@index([email], map: "user_email_key", unique: true)
  @@map("user")
}

model Account {
  id                    String        @id(map: "account_pkey")
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  Timestamp(3)?
  refreshTokenExpiresAt Timestamp(3)?
  scope                 String?
  password              String?
  createdAt             Timestamp(3)  @default(now())
  updatedAt             Timestamp(3)
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "account_userId_fkey")

  @@index([userId], map: "account_userId_idx")
  @@map("account")
}

model Category {
  id          String       @id(map: "Category_pkey")
  name        String
  slug        String
  description String?
  createdAt   Timestamp(3) @default(now())
  updatedAt   Timestamp(3)
  products    Product[]

  @@index([slug], map: "Category_slug_key", unique: true)
  @@map("Category")
}

model PrismaMigrations {
  id                VarChar(36)  @id(map: "_prisma_migrations_pkey")
  checksum          VarChar(64)
  finishedAt        Timestamptz? @map("finished_at")
  migrationName     VarChar(255) @map("migration_name")
  logs              String?
  rolledBackAt      Timestamptz? @map("rolled_back_at")
  startedAt         Timestamptz  @default(now()) @map("started_at")
  appliedStepsCount Int          @default(0) @map("applied_steps_count")

  @@map("_prisma_migrations")
}

model Product {
  id              String           @id(map: "Product_pkey")
  name            String
  slug            String
  description     String?
  price           Numeric(10, 2)
  comparePrice    Numeric(10, 2)?
  sku             String?
  stock           Int              @default(0)
  active          Boolean          @default(true)
  featured        Boolean          @default(false)
  categoryId      String?
  productImages   ProductImage[]
  productVariants ProductVariant[]
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Product_categoryId_fkey")

  @@index([active], map: "Product_active_idx")
  @@index([categoryId], map: "Product_categoryId_idx")
  @@index([featured], map: "Product_featured_idx")
  @@index([sku], map: "Product_sku_key", unique: true)
  @@index([slug], map: "Product_slug_key", unique: true)
  @@map("Product")
}

model ProductImage {
  id        String  @id(map: "ProductImage_pkey")
  url       String
  alt       String?
  position  Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ProductImage_productId_fkey")

  @@index([productId], map: "ProductImage_productId_idx")
  @@map("ProductImage")
}

model ProductVariant {
  id        String          @id(map: "ProductVariant_pkey")
  name      String?
  color     String?
  size      String?
  sku       String?
  stock     Int             @default(0)
  price     Numeric(10, 2)?
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ProductVariant_productId_fkey")

  @@index([productId], map: "ProductVariant_productId_idx")
  @@index([sku], map: "ProductVariant_sku_key", unique: true)
  @@map("ProductVariant")
}

model Session {
  id        String       @id(map: "session_pkey")
  expiresAt Timestamp(3)
  token     String
  createdAt Timestamp(3) @default(now())
  updatedAt Timestamp(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "session_userId_fkey")

  @@index([token], map: "session_token_key", unique: true)
  @@index([userId], map: "session_userId_idx")
  @@map("session")
}

model Verification {
  id         String       @id(map: "verification_pkey")
  identifier String
  value      String
  expiresAt  Timestamp(3)
  createdAt  Timestamp(3) @default(now())
  updatedAt  Timestamp(3)

  @@index([identifier], map: "verification_identifier_idx")
  @@map("verification")
}

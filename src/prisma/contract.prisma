// use prisma-8

model User {
  id            Int    @id @default(autoincrement())
  name          String
  email         String
  emailVerified Boolean?
  image         String?
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
  sessions      Session[]
  accounts      Account[]
  orders        Order[]
  cadastro      CadastroUser?
  favorites     Favorite[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        Int   @id @default(autoincrement())
  expiresAt TimestamptzString
  token     String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  ipAddress String?
  userAgent String?
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    Int    @id @default(autoincrement())
  accountId             String
  providerId            String
  userId                Int
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  TimestamptzString?
  refreshTokenExpiresAt TimestamptzString?
  scope                 String?
  password              String?
  createdAt             TimestamptzString @default(now())
  updatedAt             temporal.updatedAtString()

  @@map("account")
}

model Verification {
  id         Int    @id @default(autoincrement())
  identifier String
  value      String
  expiresAt  TimestamptzString
  createdAt  TimestamptzString?
  updatedAt  TimestamptzString?

  @@map("verification")
}

model OrderStatus {
  id          Int                  @id @default(autoincrement())
  title       String               @unique
  isActive    Boolean              @default(true)
  orders      Order[]
}

model Order {
  id            Int                 @id @default(autoincrement())
  name          String
  quantity      Int                 @default(0)
  createdAt     TimestamptzString   @default(now())
  updatedAt     TimestamptzString

  status        OrderStatus         @relation(fields: [statusId], references: [id])
  statusId      Int                 @default(1)

  user          User                @relation(fields: [userId], references: [id])
  userId        Int

  @@map("order")
}

model Product {
  id            Int                 @id @default(autoincrement())
  name          String
  model         String
  quantity      Int                 @default(0)
  description   String
  price         Int
  sku           String
  image         String?
  size          String?
  assorted      Boolean             @default(true)
  brand         String?
  isFeatured    Boolean             @default(false)
  isBestSeller  Boolean             @default(false)
  isOnSale      Boolean             @default(false)
  isNewArrival  Boolean             @default(false)
  favorites     Favorite[]

  @@map("product")             
}

model CadastroUser {
  id            Int                 @id @default(autoincrement())
  nameComplete  String?
  line1         String
  number        String
  city          String
  state         String
  postal_code   String
  country       String
  phone         String?

  user          User                @relation(fields: [userId], references: [id])
  userId        Int                 @unique

  @@map("cadastro")
}

model Favorite {
  id            Int                 @id @default(autoincrement())
  userId        Int
  productId     Int
  createdAt     DateTime            @default(now())

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])

  @@map("favorites")
}

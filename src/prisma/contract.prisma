// use prisma-8

model User {
  id            Int    @id
  name          String
  email         String
  image         String?
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
  sessions      Session[]
  accounts      Account[]
  orders        Order[]
  cadastro      CadastroUser?

  @@unique([email])
  @@map("user")
}

model Session {
  id        Int   @id
  expiresAt TimestamptzString
  token     String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  ipAddress String?
  userAgent String?
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    Int    @id
  accountId             String
  providerId            String
  userId                Int
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  TimestamptzString?
  refreshTokenExpiresAt TimestamptzString?
  scope                 String?
  password              String?
  createdAt             TimestamptzString @default(now())
  updatedAt             temporal.updatedAtString()

  @@map("account")
}

model OrderStatus {
  id          Int                  @id @default(autoincrement())
  title       String               @unique
  isActive    Boolean              @default(true)
  orders      Order[]
}

model Order {
  id            Int                 @id @default(autoincrement())
  name          String
  quantity      Int                 @default(0)
  createdAt     TimestamptzString   @default(now())
  updatedAt     TimestamptzString

  status        OrderStatus         @relation(fields: [statusId], references: [id])
  statusId      Int                 @default(1)

  user          User                @relation(fields: [userId], references: [id])
  userId        Int

  @@map("order")
}

model Product {
  id            Int                 @id @default(autoincrement())
  name          String
  modelo        String
  quantity      Int                 @default(0)
  description   String
  price         Int
  sku           String
  imagem        String?

  @@map("product")             
}

model CadastroUser {
  id            Int                 @id @default(autoincrement())
  nameComplete  String?
  line1         String
  number        String
  city          String
  state         String
  postal_code   String
  country       String
  phone         String?

  user          User                @relation(fields: [userId], references: [id])
  userId        Int                 @unique

  @@map("cadastro")
}